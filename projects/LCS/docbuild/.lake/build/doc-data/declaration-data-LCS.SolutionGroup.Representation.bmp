ute</a> <span class=\"fn\">(<span class=\"fn\">obs</span> <span class=\"fn\">↑<span class=\"fn\">j</span></span>)</span> <span class=\"fn\">(<span class=\"fn\">obs</span> <span class=\"fn\">↑<span class=\"fn\">k</span></span>)</span></span></span></span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.rowObservableProduct\">rowObservableProduct</a> <span class=\"fn\">obs</span> <span class=\"fn\">i</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span>)</span>.<a href=\"./Mathlib/Data/Finset/Attach.html#Finset.attach\">attach</a></span>.<a href=\"./Mathlib/Data/Finset/NoncommProd.html#Finset.noncommProd\">noncommProd</a></span> <span class=\"fn\">(fun (<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Subtype\">{</a> <span class=\"fn\">x</span> <a href=\"./Init/Prelude.html#Subtype\">:</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.s\">s</a></span></span> <a href=\"./Init/Prelude.html#Subtype\">//</a> <span class=\"fn\">x</span> <a href=\"./Init/Prelude.html#Membership.mem\">∈</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span></span> <a href=\"./Init/Prelude.html#Subtype\">}</a>) =&gt; <span class=\"fn\"><span class=\"fn\">obs</span> <span class=\"fn\">↑<span class=\"fn\">j</span></span></span>)</span> <span class=\"fn\">⋯</span></span></div></div>","info":{"doc":"Relate the sorted row observable product to the `noncommProd` used by\n`Alice_Row_Prod`:\n$$\n  \\operatorname{rowObservableProduct}_i\n    = \\prod_{j \\in V_i}^{\\mathrm{noncomm}}\\operatorname{obs}_j.\n$$\n`rowObservableProduct` uses a sorted list to match `equationWord`, while\n`Alice_Row_Prod` uses `Finset.noncommProd` over the attached row support.  This\nbridge is useful when importing the row identity extracted from the EPR/SOS\npipeline.\n","docLink":"./LCS/SolutionGroup/Representation.html#SolutionGroup.rowObservableProduct_eq_noncommProd","kind":"theorem","line":510,"name":"SolutionGroup.rowObservableProduct_eq_noncommProd","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L510-L528"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.orderedSupportProduct_eq_noncommProd\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">orderedSupportProduct_eq_noncommProd</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">G</span> : <a href=\"./LCS/Basic.html#LCSLayout\">LCSLayout</a>}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">M</span> : <a href=\"./foundational_types.html\">Type</a> u_2}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Mathlib/Algebra/Group/Defs.html#Monoid\">Monoid</a> <span class=\"fn\">M</span></span>]</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.s\">s</a></span></span> → <span class=\"fn\">M</span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">i</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.r\">r</a></span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">sameEquation_comm</span> : <span class=\"fn\">∀ (<span class=\"fn\">i</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.r\">r</a></span></span>), <span class=\"fn\"><a href=\"./Mathlib/Logic/Pairwise.html#Pairwise\">Pairwise</a> <span class=\"fn\">fun (<span class=\"fn\">j</span> <span class=\"fn\">k</span> : <span class=\"fn\">↥<span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span>)</span></span>) =&gt; <span class=\"fn\"><a href=\"./Mathlib/Algebra/Group/Commute/Defs.html#Commute\">Commute</a> <span class=\"fn\">(<span class=\"fn\">f</span> <span class=\"fn\">↑<span class=\"fn\">j</span></span>)</span> <span class=\"fn\">(<span class=\"fn\">f</span> <span class=\"fn\">↑<span class=\"fn\">k</span></span>)</span></span></span></span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.orderedSupportProduct\">orderedSupportProduct</a> <span class=\"fn\">f</span> <span class=\"fn\">i</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span>)</span>.<a href=\"./Mathlib/Data/Finset/Attach.html#Finset.attach\">attach</a></span>.<a href=\"./Mathlib/Data/Finset/NoncommProd.html#Finset.noncommProd\">noncommProd</a></span> <span class=\"fn\">(fun (<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Subtype\">{</a> <span class=\"fn\">x</span> <a href=\"./Init/Prelude.html#Subtype\">:</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.s\">s</a></span></span> <a href=\"./Init/Prelude.html#Subtype\">//</a> <span class=\"fn\">x</span> <a href=\"./Init/Prelude.html#Membership.mem\">∈</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span></span> <a href=\"./Init/Prelude.html#Subtype\">}</a>) =&gt; <span class=\"fn\"><span class=\"fn\">f</span> <span class=\"fn\">↑<span class=\"fn\">j</span></span></span>)</span> <span class=\"fn\">⋯</span></span></div></div>","info":{"doc":"Relate the sorted row product to `Finset.noncommProd`:\n$$\n  \\prod_{j \\in V_i}^{\\mathrm{sorted}} f_j\n    = \\prod_{j \\in V_i}^{\\mathrm{noncomm}} f_j.\n$$\nThis is the monoid-level support-product lemma.  The sorted list fixes the same\ncanonical order used by `equationWord`, while `noncommProd` is convenient for\nstrategy row products.  Pairwise commutation makes the two presentations agree.\n","docLink":"./LCS/SolutionGroup/Representation.html#SolutionGroup.orderedSupportProduct_eq_noncommProd","kind":"theorem","line":467,"name":"SolutionGroup.orderedSupportProduct_eq_noncommProd","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L467-L508"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">noncomputable def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.rowObservableProduct\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">rowObservableProduct</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">G</span> : <a href=\"./LCS/Basic.html#LCSLayout\">LCSLayout</a>}</span></span>\n</span><span class=\"impl_arg\"><span cla