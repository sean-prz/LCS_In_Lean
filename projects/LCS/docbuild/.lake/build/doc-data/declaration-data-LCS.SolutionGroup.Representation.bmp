">ℂ</a></span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">obs_is_observable</span> : <span class=\"fn\">∀ (<span class=\"fn\">j</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">S</span>.<a href=\"./LCS/Basic.html#LinearSystem.layout\">layout</a></span>.<a href=\"./LCS/Basic.html#LCSLayout.s\">s</a></span></span>), <span class=\"fn\"><a href=\"./LCS/Observable.html#IsObservable\">IsObservable</a> <span class=\"fn\">(<span class=\"fn\">obs</span> <span class=\"fn\">j</span>)</span></span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">hrel</span> : <span class=\"fn\">∀ <span class=\"fn\">r</span> ∈ <span class=\"fn\"><a href=\"./LCS/SolutionGroup.html#solutionRelators\">solutionRelators</a> <span class=\"fn\">S</span></span>, <span class=\"fn\"><span class=\"fn\">(<a href=\"./Mathlib/GroupTheory/FreeGroup/Basic.html#FreeGroup.lift\">FreeGroup.lift</a> <span class=\"fn\">(<a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.solutionGroupGeneratorImage\">solutionGroupGeneratorImage</a> <span class=\"fn\">obs</span> <span class=\"fn\">obs_is_observable</span>)</span>)</span> <span class=\"fn\">r</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">1</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.solutionGroupRepresentationOfRelatorProof\">solutionGroupRepresentationOfRelatorProof</a> <span class=\"fn\">obs</span> <span class=\"fn\">obs_is_observable</span> <span class=\"fn\">hrel</span>)</span> <a href=\"./LCS/SolutionGroup.html#SolutionGroup.J\">J</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.negOneMatrixUnit\">negOneMatrixUnit</a></div></div>","info":{"doc":"