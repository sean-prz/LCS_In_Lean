oup/Representation.html#SolutionGroup.observableMatrixUnit_sq","kind":"theorem","line":128,"name":"SolutionGroup.observableMatrixUnit_sq","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L128-L138"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.involutiveMatrixUnit_sq\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">involutiveMatrixUnit_sq</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">n</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Mathlib/Data/Fintype/Defs.html#Fintype\">Fintype</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">M</span> : <span class=\"fn\"><a href=\"./Mathlib/LinearAlgebra/Matrix/Defs.html#Matrix\">Matrix</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span> <a href=\"./Mathlib/Data/Complex/Basic.html#Complex\">ℂ</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">hM</span> : <span class=\"fn\">M</span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">M</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">1</span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.involutiveMatrixUnit\">involutiveMatrixUnit</a> <span class=\"fn\">M</span> <span class=\"fn\">hM</span></span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">1</span></div></div>","info":{"doc":"An involutive matrix unit squares to the identity unit:\n$$\n  \\operatorname{involutiveMatrixUnit}(M)^2 = 1.\n$$\nThis discharges the $x_j^2 = 1$ and $J^2 = 1$ style relators after matrices are\nturned into units.\n","docLink":"./LCS/SolutionGroup/Representation.html#SolutionGroup.involutiveMatrixUnit_sq","kind":"theorem","line":115,"name":"SolutionGroup.involutiveMatrixUnit_sq","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L115-L126"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.negOneMatrixUnit_val\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">negOneMatrixUnit_val</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">n</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Mathlib/Data/Fintype/Defs.html#Fintype\">Fintype</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">↑<a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.negOneMatrixUnit\">negOneMatrixUnit</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">-<span class=\"fn\">1</span></span> <a href=\"./Init/Prelude.html#HSMul.hSMul\">•</a> <span class=\"fn\">1</span></div></div>","info":{"doc":"The underlying matrix of the distinguished unit for $J$ is $-I$:\n$$\n  \\operatorname{val}(\\operatorname{negOneMatrixUnit}) = -I.\n$$\nThis is used whenever a group-level expression involving $J$ is compared with a\nmatrix row identity.\n","docLink":"./LCS/SolutionGroup/Representation.html#SolutionGroup.negOneMatrixUnit_val","kind":"theorem","line":103,"name":"SolutionGroup.negOneMatrixUnit_val","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L103-L113"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.observableMatrixUnit_val\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">observableMatrixUnit_val</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">n</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Mathlib/Data/Fintype/Defs.html#Fintype\">Fintype</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">M</span> : <span class=\"fn\"><a href=\"./Mathlib/LinearAlgebra/Matrix/Defs.html#Matrix\">Matrix</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span> <a href=\"./Mathlib/Data/Complex/Basic.html#Complex\">ℂ</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">hM</span> : <span class=\"fn\"><a href=\"./LCS/Observable.html#IsObservable\">IsObservable</a> <span class=\"fn\">M</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">↑<span class=\"fn\">(<a href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.observableMatrixUnit\">observableMatrixUnit</a> <span class=\"fn\">M</span> <span class=\"fn\">hM</span>)</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">M</span></div></div>","info":{"doc":"The underlying matrix of `observableMatrixUnit M hM` is $M$:\n$$\n  \\operatorname{val}(\\operatorname{observableMatrixUnit}(M)) = M.\n$$\nThis simp lemma keeps generator-image computations at the matrix level after an\nobservable has been packaged as a unit.\n","docLink":"./LCS/SolutionGroup/Representation.html#SolutionGroup.observableMatrixUnit_val","kind":"theorem","line":91,"name":"SolutionGroup.observableMatrixUnit_val","sourceLink":"https://github.com/sean-prz/lean/blob/d22cd063b437e364b0ca3c0e65dc5e07461a93fd/projects/LCS/LCS/SolutionGroup/Representation.lean#L91-L101"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./LCS/SolutionGroup/Representation.html#SolutionGroup.involutiveMatrixUnit_val\"><span class=\"name\">SolutionGroup</span>.<span class=\"name\">involutiveMatrixUnit_val</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">n</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Mathlib/Data/Fintype/Defs.html#Fintype\">Fintype</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <span class=\"fn\">n</span></span>]</span></span>\n</span><span class=\"decl_args\">\