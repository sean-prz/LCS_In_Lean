.V\">V</a></span> <span class=\"fn\">i</span>)</span></span></span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">hLoss</span> :\n  <span class=\"fn\">∀ (<span class=\"fn\">i</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.r\">r</a></span></span>) (<span class=\"fn\">j</span> : <span class=\"fn\">↥<span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">G</span>.<a href=\"./LCS/Basic.html#LCSLayout.V\">V</a></span> <span class=\"fn\">i</span>)</span></span>),\n    <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<a href=\"./LCS/WinningCondition.html#local_loss_operator\">local_loss_operator</a> <span class=\"fn\">game</span>\n            <span class=\"fn\">(<a href=\"./LCS/Strategy/Equivalence.html#ObservableStrategy_To_ProjectorStrategy\">ObservableStrategy_To_ProjectorStrategy</a>\n              <span class=\"fn\">(<a href=\"./LCS/Strategy/ObservableStrategy.html#BipartiteObservableStrategy\">BipartiteObservableStrategy</a> <span class=\"fn\">obs</span> <span class=\"fn\">obs_is_observable</span> <span class=\"fn\">sameEquation_comm</span>)</span>)</span>\n            <span class=\"fn\">i</span> <span class=\"fn\">j</span>)</span>.<a href=\"./Mathlib/Data/Matrix/Mul.html#Matrix.mulVec\">mulVec</a></span>\n        <span class=\"fn\">(<a href=\"./LCS/EPR.html#eprVec\">eprVec</a> <span class=\"fn\">n</span>)</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a>       <span class=\"fn\">0</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./LCS/SolutionGroup.html#SolutionGroup\">SolutionGroup</a> <span class=\"fn\"><span class=\"fn\">game</span>.<a href=\"./LCS/Basic.html#LCSGame.toLinearSystem\">toLinearSystem</a></span></span> <a href=\"./Mathlib/Algebra/Group/Hom/Defs.html#MonoidHom\">→*</a> <span class=\"fn\">(<a href=\"./Mathlib/LinearA